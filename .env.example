# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/preet_english"
DATABASE_SSL=true

# OpenAI Configuration (CRITICAL for AI features)
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_ORG_ID="org-your-organization-id" # Optional

# Security Configuration
JWT_SECRET="your-jwt-secret-here-minimum-32-characters-long"
SESSION_SECRET="your-session-secret-here-minimum-32-characters-long"
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW=15  # minutes
RATE_LIMIT_MAX=100    # requests per window

# Application Configuration
NODE_ENV="production"
PORT=5000
HOST="0.0.0.0"

# External Services
REDIS_URL="redis://localhost:6379"  # Optional for caching
CDN_URL="https://cdn.preetenglish.com"  # Optional for assets

# Monitoring & Analytics (Optional)
SENTRY_DSN="https://your-sentry-dsn-here"
POSTHOG_KEY="your-posthog-key-here"

# Email Configuration (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# AI Service Limits (Cost Control)
DAILY_TOKEN_LIMIT=50000    # ~$1.50/day per user
DAILY_REQUEST_LIMIT=100    # Max AI requests per day per user
DAILY_COST_LIMIT=2.00      # Max $2/day per user

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_SPEECH_RECOGNITION=true
ENABLE_ANALYTICS=true
ENABLE_OFFLINE_MODE=true

# Vercel Specific (for deployment)
VERCEL_URL="your-app.vercel.app"
VERCEL_ENV="production"
