# Production Environment Configuration for PREET_ENGLISH

# CRITICAL: Get your OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-actual-openai-key-here"
OPENAI_ORG_ID="org-your-organization-id"  # Optional

# Production Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/preet_english_prod"
DATABASE_SSL=true

# Security Configuration
JWT_SECRET="your-production-jwt-secret-minimum-32-characters-long-secure"
SESSION_SECRET="your-production-session-secret-minimum-32-characters-long"
BCRYPT_ROUNDS=12

# Application Configuration
NODE_ENV="production"
PORT=5000
HOST="0.0.0.0"

# AI Service Limits (Cost Control)
DAILY_TOKEN_LIMIT=50000    # ~$1.50/day per user
DAILY_REQUEST_LIMIT=100    # Max AI requests per day per user
DAILY_COST_LIMIT=2.00      # Max $2/day per user

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_SPEECH_RECOGNITION=true
ENABLE_ANALYTICS=true
ENABLE_OFFLINE_MODE=true

# Rate Limiting
RATE_LIMIT_WINDOW=15  # minutes
RATE_LIMIT_MAX=100    # requests per window