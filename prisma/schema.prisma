// Prisma Schema for PREET ENGLISH
// Migrated from Drizzle ORM (SQLite) to Prisma (PostgreSQL)
// Week 1 Implementation - Foundation & Infrastructure

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // For migrations
}

// ============================================
// CORE TABLES
// ============================================

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  password          String
  isAdmin           Boolean   @default(false) @map("is_admin")
  
  // Timestamps
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  
  // Relations
  conversations     Conversation[]
  progress          Progress[]
  userStats         UserStats?
  quizAttempts      QuizAttempt[]
  quizResults       QuizResult[]
  activityFeed      ActivityFeed[]
  contentRatings    ContentRating[]
  dailyGoals        DailyGoal?
  speakingSessions  SpeakingSession[]
  speakingProfile   UserSpeakingProfile?
  pronunciationProgress PronunciationProgress[]
  culturalProgress  CulturalScenarioProgress[]
  
  @@index([username])
  @@map("users")
}

model Lesson {
  id                String    @id @default(cuid())
  title             String
  slug              String    @unique
  description       String
  content           String    @db.Text
  difficulty        String
  order             Int
  imageUrl          String?   @map("image_url")
  emojiTheme        String?   @map("emoji_theme")
  hindiTitle        String?   @map("hindi_title")
  hindiDescription  String?   @map("hindi_description")
  category          String    @default("General")
  speakingExercises String?   @map("speaking_exercises") @db.Text
  
  // Timestamps
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  
  // Relations
  vocabulary        Vocabulary[]
  conversationLines ConversationLine[]
  progress          Progress[]
  quizzes           Quiz[]
  speakingSessions  SpeakingSession[]
  
  @@index([category, difficulty])
  @@index([slug])
  @@map("lessons")
}

model Vocabulary {
  id                      String    @id @default(cuid())
  lessonId                String    @map("lesson_id")
  word                    String
  pronunciation           String?
  definition              String
  example                 String
  hindiTranslation        String?   @map("hindi_translation")
  hindiPronunciation      String?   @map("hindi_pronunciation")
  exampleHindi            String?   @map("example_hindi")
  usageHindi              String?   @map("usage_hindi")
  audioUrl                String?   @map("audio_url")
  pronunciationDifficulty Int       @default(1) @map("pronunciation_difficulty")
  commonMispronunciation  String?   @map("common_mispronunciation")
  
  // Relations
  lesson                  Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@index([lessonId])
  @@index([word])
  @@map("vocabulary")
}

model ConversationLine {
  id          String    @id @default(cuid())
  lessonId    String    @map("lesson_id")
  speaker     String
  englishText String    @map("english_text")
  hindiText   String    @map("hindi_text")
  emoji       String?
  lineOrder   Int       @map("line_order")
  
  // Relations
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@index([lessonId, lineOrder])
  @@map("conversation_lines")
}

model Progress {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  lessonId    String    @map("lesson_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("progress")
}

// ============================================
// CONVERSATION SYSTEM
// ============================================

model Conversation {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  title     String
  createdAt DateTime  @default(now()) @map("created_at")
  
  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  
  @@index([userId, createdAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  role           String
  content        String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  
  // Relations
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================
// GAMIFICATION SYSTEM
// ============================================

model UserStats {
  id                      String    @id @default(cuid())
  userId                  String    @unique @map("user_id")
  xpPoints                Int       @default(0) @map("xp_points")
  level                   Int       @default(1)
  currentStreak           Int       @default(0) @map("current_streak")
  longestStreak           Int       @default(0) @map("longest_streak")
  lastActiveDate          DateTime? @map("last_active_date")
  totalLessonsCompleted   Int       @default(0) @map("total_lessons_completed")
  totalQuizzesPassed      Int       @default(0) @map("total_quizzes_passed")
  totalMinutesLearned     Int       @default(0) @map("total_minutes_learned")
  speakingMinutes         Int       @default(0) @map("speaking_minutes")
  pronunciationAccuracyAvg Int      @default(0) @map("pronunciation_accuracy_avg")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([level, xpPoints])
  @@map("user_stats")
}

model DailyGoal {
  id               String    @id @default(cuid())
  userId           String    @unique @map("user_id")
  lessonsCompleted Int       @default(0) @map("lessons_completed")
  xpEarned         Int       @default(0) @map("xp_earned")
  minutesSpent     Int       @default(0) @map("minutes_spent")
  lastUpdated      DateTime  @default(now()) @map("last_updated")
  
  // Relations
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("daily_goals")
}

model ActivityFeed {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  type        String
  referenceId Int?      @map("reference_id")
  content     String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@map("activity_feed")
}

model ContentRating {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  contentType String    @map("content_type")
  contentId   Int       @map("content_id")
  rating      Int
  review      String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([contentType, contentId])
  @@map("content_ratings")
}

// ============================================
// QUIZ SYSTEM
// ============================================

model Quiz {
  id                String         @id @default(cuid())
  title             String
  titleHindi        String?        @map("title_hindi")
  description       String?        @db.Text
  descriptionHindi  String?        @map("description_hindi") @db.Text
  difficulty        String
  category          String
  passingScore      Int            @default(70) @map("passing_score")
  timeLimit         Int?           @map("time_limit")
  order             Int            @default(0)
  lessonId          String?        @map("lesson_id")
  xpReward          Int            @default(50) @map("xp_reward")
  hintsAllowed      Boolean        @default(true) @map("hints_allowed")
  
  // Relations
  lesson            Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questions         QuizQuestion[]
  attempts          QuizAttempt[]
  results           QuizResult[]
  
  @@index([category, difficulty])
  @@index([lessonId])
  @@map("quizzes")
}

model QuizQuestion {
  id                String    @id @default(cuid())
  quizId            String    @map("quiz_id")
  questionText      String    @map("question_text") @db.Text
  questionTextHindi String?   @map("question_text_hindi") @db.Text
  questionType      String    @map("question_type")
  options           String?   @db.Text // JSON string
  correctAnswer     String    @map("correct_answer")
  explanation       String?   @db.Text
  explanationHindi  String?   @map("explanation_hindi") @db.Text
  points            Int       @default(10)
  order             Int       @default(0)
  
  // Relations
  quiz              Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  @@index([quizId, order])
  @@map("quiz_questions")
}

model QuizAttempt {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  quizId         String    @map("quiz_id")
  score          Int
  totalQuestions Int       @map("total_questions")
  answers        String?   @db.Text // JSON string
  timeSpent      Int?      @map("time_spent")
  passed         Boolean   @default(false)
  completedAt    DateTime  @default(now()) @map("completed_at")
  
  // Relations
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz           Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  @@index([userId, quizId])
  @@map("quiz_attempts")
}

model QuizResult {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  quizId         String    @map("quiz_id")
  score          Int
  totalQuestions Int       @map("total_questions")
  passed         Boolean   @default(false)
  completedAt    DateTime  @default(now()) @map("completed_at")
  
  // Relations
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz           Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("quiz_results")
}

// ============================================
// CONTENT TYPES
// ============================================

model Scenario {
  id                String            @id @default(cuid())
  title             String
  titleHindi        String?           @map("title_hindi")
  description       String?           @db.Text
  descriptionHindi  String?           @map("description_hindi") @db.Text
  yourRole          String?           @map("your_role")
  yourRoleHindi     String?           @map("your_role_hindi")
  partnerRole       String?           @map("partner_role")
  partnerRoleHindi  String?           @map("partner_role_hindi")
  category          String
  difficulty        String
  dialogues         String            @db.Text // JSON string
  tips              String?           @db.Text
  xpReward          Int               @default(30) @map("xp_reward")
  
  // Relations
  speakingSessions  SpeakingSession[]
  
  @@index([category, difficulty])
  @@map("scenarios")
}

model Story {
  id              String    @id @default(cuid())
  title           String
  titleHindi      String?   @map("title_hindi")
  description     String    @db.Text
  descriptionHindi String?  @map("description_hindi") @db.Text
  content         String    @db.Text
  contentHindi    String?   @map("content_hindi") @db.Text
  imageUrl        String?   @map("image_url")
  difficulty      String
  category        String
  order           Int       @default(0)
  vocabulary      String?   @db.Text // JSON string
  xpReward        Int       @default(50) @map("xp_reward")
  
  @@index([category, difficulty])
  @@map("stories")
}

model Listening {
  id              String    @id @default(cuid())
  title           String
  titleHindi      String?   @map("title_hindi")
  description     String    @db.Text
  descriptionHindi String?  @map("description_hindi") @db.Text
  difficulty      String
  category        String
  audioText       String    @map("audio_text") @db.Text
  audioTextHindi  String?   @map("audio_text_hindi") @db.Text
  duration        String?
  questions       String    @db.Text // JSON string
  vocabulary      String?   @db.Text // JSON string
  order           Int       @default(0)
  
  @@index([category, difficulty])
  @@map("listenings")
}

model SpeakingTopic {
  id              String    @id @default(cuid())
  title           String
  hindiTitle      String?   @map("hindi_title")
  difficulty      String
  emoji           String?
  category        String
  hindiThoughts   String?   @map("hindi_thoughts") @db.Text
  sentenceFrames  String?   @map("sentence_frames") @db.Text // JSON string
  modelAnswer     String?   @map("model_answer") @db.Text
  freePrompt      String?   @map("free_prompt") @db.Text
  confidenceTip   String?   @map("confidence_tip") @db.Text
  order           Int       @default(0)
  
  @@index([category, difficulty])
  @@map("speaking_topics")
}

// ============================================
// SPEAKING PRACTICE SYSTEM
// ============================================

model SpeakingSession {
  id                 String            @id @default(cuid())
  userId             String            @map("user_id")
  lessonId           String?           @map("lesson_id")
  scenarioId         String?           @map("scenario_id")
  sessionType        String            @map("session_type")
  durationSeconds    Int               @map("duration_seconds")
  overallScore       Int?              @map("overall_score")
  pronunciationScore Int?              @map("pronunciation_score")
  fluencyScore       Int?              @map("fluency_score")
  confidenceScore    Int?              @map("confidence_score")
  createdAt          DateTime          @default(now()) @map("created_at")
  completedAt        DateTime?         @map("completed_at")
  
  // Relations
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson             Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  scenario           Scenario?         @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  attempts           SpeakingAttempt[]
  
  @@index([userId, createdAt])
  @@map("speaking_sessions")
}

model SpeakingAttempt {
  id                   String          @id @default(cuid())
  sessionId            String          @map("session_id")
  expectedText         String?         @map("expected_text") @db.Text
  spokenText           String          @map("spoken_text") @db.Text
  accuracyScore        Int             @map("accuracy_score")
  pronunciationIssues  String?         @map("pronunciation_issues") @db.Text
  feedbackData         String?         @map("feedback_data") @db.Text // JSON string
  audioDurationMs      Int?            @map("audio_duration_ms")
  attemptNumber        Int             @map("attempt_number")
  createdAt            DateTime        @default(now()) @map("created_at")
  
  // Relations
  session              SpeakingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@index([sessionId, attemptNumber])
  @@map("speaking_attempts")
}

model UserSpeakingProfile {
  id                        String    @id @default(cuid())
  userId                    String    @unique @map("user_id")
  currentLevel              String    @default("beginner") @map("current_level")
  weakPhonemes              String?   @map("weak_phonemes") @db.Text
  strongAreas               String?   @map("strong_areas") @db.Text
  preferredPracticeType     String    @default("mixed") @map("preferred_practice_type")
  culturalContextPreference String    @default("indian_english") @map("cultural_context_preference")
  totalPracticeMinutes      Int       @default(0) @map("total_practice_minutes")
  lastAssessmentDate        DateTime? @map("last_assessment_date")
  improvementRate           Int       @default(0) @map("improvement_rate")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_speaking_profiles")
}

model PronunciationProgress {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  phoneme         String
  accuracyHistory String?   @map("accuracy_history") @db.Text // JSON string
  practiceCount   Int       @default(0) @map("practice_count")
  lastPracticed   DateTime? @map("last_practiced")
  masteryLevel    String    @default("learning") @map("mastery_level")
  createdAt       DateTime  @default(now()) @map("created_at")
  
  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, phoneme])
  @@map("pronunciation_progress")
}

model CulturalScenarioProgress {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  scenarioType    String    @map("scenario_type")
  completionCount Int       @default(0) @map("completion_count")
  bestScore       Int       @default(0) @map("best_score")
  confidenceLevel Int       @default(50) @map("confidence_level")
  lastPracticed   DateTime? @map("last_practiced")
  notes           String?   @db.Text
  
  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, scenarioType])
  @@map("cultural_scenario_progress")
}
