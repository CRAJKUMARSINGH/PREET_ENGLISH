{
    "extends": "./tsconfig.json",
    "include": [
        "client/src/**/*",
        "shared/**/*",
        "server/**/*"
    ],
    "exclude": [
        "node_modules",
        "build",
        "dist",
        "scripts/**/*",
        "tests/**/*",
        "**/*.test.ts",
        "**/*.test.tsx"
    ],
    "compilerOptions": {
        "noEmit": true,
        "skipLibCheck": true,
        "strict": false,
        "target": "es2020",
        "lib": [
            "es2020",
            "dom",
            "dom.iterable"
        ]
    }
}